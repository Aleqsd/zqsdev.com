# OpenAI is optional: without a key, classic commands and CV remain available.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.6-luna
# Luna defaults (USD per million tokens, verified 2026-09-08).
# A different model requires all four prices explicitly.
# AI_INPUT_USD_PER_MILLION=0.20
# AI_CACHED_USD_PER_MILLION=0.02
# AI_CACHE_WRITE_USD_PER_MILLION=0.25
# AI_OUTPUT_USD_PER_MILLION=1.20
# AI_MINUTE_BUDGET_USD=0.50
# AI_HOUR_BUDGET_USD=2
# AI_DAY_BUDGET_USD=2
# AI_MONTH_BUDGET_USD=10
# AI_BUDGET_PATH=logs/ai-budget.json
# HOST=127.0.0.1
# PORT=3000
# STATIC_DIR=static
# No Pinecone, embeddings, SQLite, Groq or Gemini needed at runtime/build time.
